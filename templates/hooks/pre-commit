#!/usr/bin/env bash
# Git Pre-commit Hook: Universal Safety Guard
# Dipasang otomatis oleh agent-blueprint (agent-init)

set -e

# Warna output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 [agent-blueprint] Memeriksa staged files sebelum commit..."

# 1. Cek file terlarang / credentials yang masuk ke git
FORBIDDEN_FILES=(".env" ".env.local" "id_rsa" "credentials.json" ".pem")
for f in "${FORBIDDEN_FILES[@]}"; do
    if git diff --cached --name-only | grep -E "(^|/)${f}$" > /dev/null; then
        echo -e "${RED}❌ ERROR: Terdeteksi file kredensial/rahasia '${f}' dalam staged git!${NC}"
        echo -e "${YELLOW}Keluarkan file tersebut dari staging: git reset HEAD <file>${NC}"
        exit 1
    fi
done

# 2. Cek baris kunci rahasia / private key di dalam diff staged
if git diff --cached | grep -E "BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY" > /dev/null; then
    echo -e "${RED}❌ ERROR: Terdeteksi PRIVATE KEY di dalam perubahan yang akan di-commit!${NC}"
    exit 1
fi

# 3. Cek sisa debug statements terlarang di kode yang di-stage
# Cek dd(), var_dump(), debugger;
STAGED_CODE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(php|js|ts|dart|cs)$" || true)

if [ -n "$STAGED_CODE_FILES" ]; then
    for file in $STAGED_CODE_FILES; do
        if [ -f "$file" ]; then
            # Cek dd( atau var_dump( pada file PHP
            if [[ "$file" =~ \.php$ ]]; then
                if git diff --cached "$file" | grep -E "^\+[[:space:]]*(dd\(|var_dump\(|print_r\()" > /dev/null; then
                    echo -e "${YELLOW}⚠️ PERINGATAN: Terdeteksi fungsi debug (dd/var_dump/print_r) baru di: ${file}${NC}"
                fi
            fi
            # Cek debugger; pada file JS/TS
            if [[ "$file" =~ \.(js|ts)$ ]]; then
                if git diff --cached "$file" | grep -E "^\+[[:space:]]*debugger;" > /dev/null; then
                    echo -e "${RED}❌ ERROR: Terdeteksi 'debugger;' di file JavaScript/TypeScript: ${file}${NC}"
                    exit 1
                fi
            fi
        fi
    done
fi

echo -e "${GREEN}✅ [agent-blueprint] Pre-commit validation passed.${NC}"
exit 0
